
{
  "expo": {
    "name": "StableBus",
    "slug": "stablebus",
    "scheme": "stablebus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "icon": "src/assets/scenic/icon_ticket.png",

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-image"
    ],

    "android": {
      "package": "com.stablebus.app",
      "adaptiveIcon": {
        "foregroundImage": "src/assets/scenic/icon_ticket.png",
        "backgroundColor": "#F8F4ED"
      }
    },

    "ios": {
      "bundleIdentifier": "com.stablebus.app"
    },

    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7e19669c-b56a-4e88-b946-63eda7b120c6"
      }
    }
  }
}
